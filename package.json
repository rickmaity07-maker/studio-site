{
  "name": "studio-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:studio": "node --env-file=.env.local ./node_modules/prisma/build/index.js studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:add-starters": "tsx --env-file=.env.local scripts/add-starters.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "app:release": "tsx --env-file=.env.local scripts/release-app.ts",
    "db:backfill-mobile": "tsx --env-file=.env.local scripts/backfill-mobile-screens.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "motion": "^14.12.0",
    "next": "14.2.35",
    "nodemailer": "^10.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
