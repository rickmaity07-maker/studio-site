# Easiest: `vercel link` then `vercel env pull .env.local` — that fills in
# everything below that's already set on the Vercel project.

# ── Database (Neon Postgres) ───────────────────────────────────────
# Added automatically by the Vercel ↔ Neon integration. Otherwise copy
# both connection strings from the Neon console:
#   DATABASE_URL           pooled   (used by the app)
#   DATABASE_URL_UNPOOLED  direct   (used by `npm run db:push`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Admin sign-in ──────────────────────────────────────────────────
# Signs the admin session cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Production URL (no trailing slash) — used for the sitemap and social cards
NEXT_PUBLIC_SITE_URL=

# ── New-lead email alerts via https://resend.com (optional) ────────
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Needs a domain verified in Resend. Without one, leave empty: the default
# sender only delivers to the email you signed up to Resend with.
LEAD_FROM_EMAIL=
